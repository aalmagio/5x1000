# Copia in .env e compila con i valori reali
SITE_DB_HOST=localhost
SITE_DB_PORT=3306
SITE_DB_USER=cinque_per_mille_user
SITE_DB_PASSWORD=secret
SITE_DB_NAME=cinque_per_mille

# Path assoluto alla cartella Dati/ generata dalla pipeline
DATI_DIR=/var/www/vhosts/tuodominio.it/pipeline/Dati

# Cors: domini frontend separati da virgola (es. https://tuodominio.it)
CORS_ORIGINS=*
